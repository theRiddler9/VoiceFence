# Copy this file to .env (and never commit the real one).
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=mistv2
RIME_SPEAKER=astra
RIME_LANGUAGE=eng
RIME_SAMPLING_RATE=16000
RIME_SPEED_ALPHA=1.0

# Artificial delay (seconds) for the mock order lookup/update.
# This is the knob Person D sweeps during testing.
MOCK_LOOKUP_DELAY_SECONDS=3.0
